<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      This API serves no static files; it only references PubSubWebUi for the Refit client and models.
      Without this, the .NET 11 SDK flows the Blazor app's Debug-only Hot Reload JS module into this
      project and the build fails with "scoped css bundles do not have matching endpoints".
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	  <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PubSubWebUi.ServiceDefaults\PubSubWebUi.ServiceDefaults.csproj" />
    <ProjectReference Include="..\PubSubWebUi\PubSubWebUi.csproj" />
  </ItemGroup>

</Project>
