@page "/projects"
@using PubSubWebUi.Components.Dialogs
@using PubSubWebUi.Services
@inject ProjectContext ctx
@inject IDialogService DialogService
@rendermode InteractiveServer

<FluentText As="TextTag.H3" Size="TextSize.Size600" Weight="TextWeight.Semibold"> Projects </FluentText>

<FluentStack Wrap="true">
    @foreach (var item in ctx.AvailableProjects)
    {
        <FluentCard Width="400px" Appearance="CardAppearance.Subtle" Style="display: flex;justify-content: center;cursor: pointer" OnClick="@(() => SelectedProject(item))">
            <FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold"> @item </FluentText>
        </FluentCard>
    }

    <FluentCard Width="400px" Appearance="CardAppearance.Subtle" Style="cursor: pointer" OnClick="AddNewProject">
        <div style="display: flex;justify-content: center;">
            <FluentIcon Value="@(new Icons.Regular.Size24.Add())" />
        </div>
        <div style="display: flex;justify-content: center;">
            <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold"> Attach new project </FluentText>
        </div>
    </FluentCard>
</FluentStack>

@code {
    public void SelectedProject(string project)
    {
        ctx.CurrentProject = project;
        StateHasChanged();
    }

    public async Task AddNewProject()
    {
        var result = await DialogService.ShowDialogAsync<NewProjectDialog>(options =>
        {
            options.Width = "500px";
            options.Modal = true;
            options.Parameters.Add(nameof(NewProjectDialog.Content), new NewProjectDialog.DialogData());
        });

        if (!result.Cancelled && result.GetValue<NewProjectDialog.DialogData>() is { ProjectName: { Length: > 0 } project })
        {
            ctx.AddProject(project);
        }
    }
}
