@using PubSubWebUi.Components.Dialogs
@using PubSubWebUi.Components.Models
@using PubSubWebUi.Services
@inject IPubSubService PubSubService
@inject ProjectContext ProjectContext
@inject IDialogService DialogService

<FluentStack Orientation="Orientation.Horizontal">
    <FluentText As="TextTag.H3" Size="TextSize.Size600" Weight="TextWeight.Semibold"> Subscriptions </FluentText>
    <FluentSpacer />
    @if (_subscriptions is not null)
    {
        <FluentButton IconEnd="new Icons.Regular.Size16.Add()" Title="Add new subscription" OnClick="AddNewSubscription" />
    }
</FluentStack>
<br />
@if (_loadingSubscriptions)
{
    <FluentSpinner />
}
else if (_subscriptions is [])
{
    <FluentText As="TextTag.Paragraph" Size="TextSize.Size400" Weight="TextWeight.Semibold"> No subscription for topic <b>@SelectedTopic.Name</b></FluentText>
}
else if (_subscriptions != null)
{
    <FluentListbox TOption="Subscription"
                   TValue="Subscription"
                   Items="@_subscriptions"
                   OptionValueToString="@(s => s?.Name ?? "")"
                   Width="100%"
                   @bind-Value="SelectedSubscription">
        <OptionTemplate>
            <FluentStack Class="list-option-content" Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Value="@(new Icons.Regular.Size16.MailMultiple())" />
                <span>@context.Name</span>
                <FluentSpacer />
                <FluentIcon Value="@(new Icons.Regular.Size16.Delete())"
                            Class="list-option-action"
                            Title="Delete subscription"
                            OnClick="@(() => DeleteSubscription(context))"
                            OnClickStopPropagation="true" />
            </FluentStack>
        </OptionTemplate>
    </FluentListbox>
}

@code {
    [Parameter]
    public Subscription? SelectedSubscription
    {
        get;
        set
        {
            if (field != value)
            {
                field = value;
                SelectedSubscriptionChanged.InvokeAsync(field);
            }
        }
    }

    [Parameter]
    public EventCallback<Subscription?> SelectedSubscriptionChanged { get; set; }

    [Parameter]
    public required Topic SelectedTopic { get; set; }

    [Parameter]
    public EventCallback OnSubscriptionSelected { get; set; }

    private Topic? currentTopic;
    private List<Subscription>? _subscriptions;
    private bool _loadingSubscriptions;

    protected override async Task OnParametersSetAsync()
    {
        if (currentTopic != SelectedTopic)
            await LoadSubscriptions();
        await base.OnParametersSetAsync();
    }

    private async Task LoadSubscriptions()
    {
        currentTopic = SelectedTopic;
        _loadingSubscriptions = true;
        StateHasChanged();

        var response = await PubSubService.GetSubscriptionsAsync(ProjectContext.CurrentProject);
        _subscriptions = response.Content?.Subscriptions?.Where(x => x.Topic == currentTopic.Name).ToList() ?? [];
        _loadingSubscriptions = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteSubscription(Subscription subscription)
    {
        var response = await PubSubService.DeleteSubscriptionAsync(ProjectContext.CurrentProject, subscription.SubscriptionName);
        if (response.IsSuccessful)
        {
            if (SelectedSubscription == subscription)
            {
                SelectedSubscription = null;
            }

            await DialogService.ShowSuccessAsync($"The subscription {subscription.SubscriptionName} is deleted");
            await LoadSubscriptions();
        }
    }

    private async Task AddNewSubscription()
    {
        var result = await DialogService.ShowDialogAsync<NewSubscriptionDialog>(options =>
        {
            options.Width = "500px";
            options.Parameters.Add(nameof(NewSubscriptionDialog.Content), new NewSubscription { Name = "" });
        });

        if (!result.Cancelled && result.GetValue<NewSubscription>() is { Name: { Length: > 0 } } subscription)
        {
            var request = string.IsNullOrWhiteSpace(subscription.PushEndpoint)
                ? new NewSubscriptionRequest(SelectedTopic.Name)
                : new NewSubscriptionRequest(SelectedTopic.Name, new(subscription.PushEndpoint));

            var response = await PubSubService.CreateSubscriptionAsync(ProjectContext.CurrentProject, subscription.Name, request);
            await LoadSubscriptions();
        }
    }
}
