@using PubSubWebUi.Components.Models
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical">
        <FluentTextInput Label="Subscription name:" @bind-Value="Content.Name" Width="100%" />

        <FluentSwitch @bind-Value="PushSubscription" Label="Push subscription" />

        @if (PushSubscription)
        {
            <FluentTextInput Label="Push endpoint:" @bind-Value="Content.PushEndpoint" Width="100%" />
        }
    </FluentStack>
</FluentDialogBody>

@code {
    [Parameter]
    public NewSubscription Content { get; set; } = new() { Name = "" };

    public bool PushSubscription { get; set; }

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        header.Title = "Add a subscription";
        footer.PrimaryAction.Label = "Add";
        footer.SecondaryAction.Label = "Cancel";
        footer.SecondaryAction.Visible = true;
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (primary)
        {
            if (!PushSubscription)
            {
                Content.PushEndpoint = null;
            }

            await DialogInstance.CloseAsync(Content);
        }
        else
        {
            await DialogInstance.CancelAsync();
        }
    }
}
